<%= render partial: 'serverless_admin/tabs', locals: { selected: 'status' } %>

<h3><%= l(:label_serverless_function) %></h3>
<div class="box tabular settings">
  <% function = @status.function %>
  <p><label><%= l(:field_serverless_function_name) %></label><%= function[:name] || '-' %></p>
  <p><label><%= l(:field_serverless_function_role) %></label><%= function[:role] || '-' %> <em class="info">REDMINE_ROLE</em></p>
  <p><label><%= l(:field_serverless_function_version) %></label><%= function[:version] || '-' %></p>
  <p><label><%= l(:field_serverless_function_memory) %></label><%= function[:memory] ? "#{number_with_delimiter(function[:memory].to_i)} MB" : '-' %></p>
  <p><label><%= l(:field_serverless_function_region) %></label><%= function[:region] || '-' %></p>
  <p><label><%= l(:field_serverless_function_image) %></label><%= function[:image] || '-' %></p>
</div>

<h3><%= l(:label_serverless_versions) %></h3>
<div class="box tabular settings">
  <% @status.versions.each do |name, version| %>
  <p><label><%= name %></label><%= version %></p>
  <% end %>
</div>

<% loaded = @status.loaded_settings %>
<% unless loaded.nil? %>
<h3><%= l(:label_serverless_loaded_settings) %></h3>
<% if loaded.any? %>
<div class="box">
  <p><%= safe_join(loaded.map { |name| content_tag(:code, name) }, ', ') %></p>
</div>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
<% end %>

<h3><%= l(:label_serverless_fixed_settings) %></h3>
<% if RedmineServerless.lambda? %>
<div class="box tabular settings">
  <% @status.fixed_settings.each do |name, value| %>
  <%# Lists as text ("none" when empty), switches as Yes/No %>
  <p><label><%= l(:"setting_#{name}") %></label><%= value.is_a?(Array) ? (value.join(', ').presence || l(:label_none)) : format_object(value.to_s == '1') %> <em class="info"><%= name %></em></p>
  <% end %>
</div>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>

<h3><%= l(:label_serverless_connection_check) %></h3>

<p><%= link_to l(:button_test), serverless_status_check_path, method: :post %></p>

<% if @results %>
<div class="autoscroll">
<table class="list checks"><thead>
<tr>
    <th><%= l(:field_name) %></th>
    <th><%= l(:field_status) %></th>
    <th><%= l(:label_details) %></th>
    <th><%= l(:label_serverless_response_time) %></th>
</tr></thead>
<tbody>
<% @results.each do |result| %>
<tr class="<%= result.ok ? 'ok' : 'failed' %>">
    <td class="name"><%= l(result.label) %></td>
    <td class="tick">
      <span class="icon-only icon-<%= result.ok ? 'ok' : 'error' %>">
        <%= result.ok ? sprite_icon('checked', l(:label_serverless_ok)) : sprite_icon('warning', l(:label_serverless_failed)) %>
      </span>
    </td>
    <td class="description"><%= result.detail %></td>
    <td class="milliseconds"><%= number_with_delimiter(result.milliseconds) %></td>
</tr>
<% end %>
</tbody>
</table>
</div>
<% end %>
