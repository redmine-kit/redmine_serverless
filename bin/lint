#!/usr/bin/env bash
# Static checks: RuboCop with the versions in Gemfile.lint.lock, in Docker.
set -euo pipefail
cd "$(dirname "$0")/.."
RUBY=ruby:4.0@sha256:a69f361db050bb2c65ec66ef75411bfc4ce2e1d993ba1179fac4e4ba6ecfe91f
docker run --rm -v "$PWD:/work" -w /work -v redmine-serverless-bundle:/usr/local/bundle \
  -e BUNDLE_GEMFILE=Gemfile.lint "$RUBY" sh -c 'bundle install --quiet && bundle exec rubocop "$@"' rubocop "$@"
