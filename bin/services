#!/usr/bin/env bash
# Starts PostgreSQL 16 for the tests, or stops it with --down.
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f test/compose.yml -p redmine-serverless-test)
if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi
"${compose[@]}" up -d --wait
